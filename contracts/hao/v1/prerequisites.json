{
  "contractVersion": 1,
  "defaultWorkflowProfile": "general",
  "workflowProfiles": {
    "general": { "requires": ["git", "harness"] },
    "github": { "requires": ["git", "harness", "gh"] }
  },
  "prerequisites": [
    { "id": "git", "owner": "user-package-manager", "condition": "required", "installPolicy": "always" },
    { "id": "harness", "owner": "selected-harness-vendor", "condition": "required", "installPolicy": "allowlisted-only" },
    { "id": "gh", "owner": "user-package-manager", "condition": "workflow-profile:github", "installPolicy": "always" },
    { "id": "ao-runtime", "owner": "ao-artifact", "condition": "reported-by-current-doctor-wire", "installPolicy": "never" }
  ],
  "forbiddenMachinePolicyKeys": ["runtimeBackend", "tmux"]
}
